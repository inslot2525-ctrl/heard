# Copy to .env (repo root) and fill in. Never commit .env.

# Nexconn (console → your app). Create the app in the Singapore data centre.
# The secret is used only by apps/api.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_HOST=api.sg-light-api.com

# Web app (public, safe to expose). Same App Key as above.
VITE_NEXCONN_APP_KEY=
VITE_API_URL=http://localhost:8787

# API
PORT=8787
WEB_ORIGIN=http://localhost:5173
DEMO_PASSCODE=

# Database (Neon Postgres), from Nov 5
DATABASE_URL=

# LLM (opening-line drafts, assistant bot)
GEMINI_API_KEY=
