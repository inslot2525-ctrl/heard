# Copy to .env and fill in. Never commit .env.

# Nexconn (console → your app). The secret is used only by apps/api.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_HOST=

# Web app (public, safe to expose)
VITE_NEXCONN_APP_KEY=
VITE_API_URL=http://localhost:8787

# Database (Neon Postgres)
DATABASE_URL=

# LLM (opening-line drafts, assistant bot)
GEMINI_API_KEY=

# Demo login
DEMO_PASSCODE=
